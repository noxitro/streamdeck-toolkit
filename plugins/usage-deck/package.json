{
    "name": "usage-deck",
    "version": "0.1.0",
    "license": "MIT",
    "private": true,
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.noxitro.usagedeck\"",
        "typecheck": "tsc --noEmit",
        "e2e": "npm run build && node e2e/harness.mjs",
        "link": "streamdeck link com.noxitro.usagedeck.sdPlugin",
        "validate": "streamdeck validate com.noxitro.usagedeck.sdPlugin",
        "pack": "node scripts/pack.mjs",
        "check": "node scripts/sync-version.mjs --check && tsc --noEmit && npm run build && streamdeck validate com.noxitro.usagedeck.sdPlugin --no-update-check",
        "release": "node scripts/release.mjs"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.9.0",
        "@elgato/utils": "^0.6.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@tsconfig/node20": "^20.1.10",
        "@types/node": "~24.1.0",
        "rollup": "^4.63.4",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3",
        "ws": "^8.21.3"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.2"
    }
}
